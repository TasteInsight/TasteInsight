# =============================================================================
# TasteInsight Environment Configuration - Standalone Embedding
# =============================================================================
# Scope: standalone inference and optional Fusion v3 training.
# Load: inject selected values with the shell or a dotenv launcher; Python does
#       not read this file automatically. Full backend development uses
#       backend/.env with pnpm run start:embedding.
# Values: commented entries are inference defaults or training-only examples.
# Layout: shared backend settings first, environment-specific settings last.
# Safety: inference needs no database credentials. Configure authorized database
#         access before training and keep credentials outside version control.
# =============================================================================

# --- Tuning: Python embedding defaults ---
# Sentence-BERT text encoder and Hugging Face download endpoint.
# PYTHON_EMBEDDING_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# HF_ENDPOINT=https://huggingface.co
# v2 needs no fusion training; v3 uses trained fusion_v3.pt from the model directory.
# PYTHON_EMBEDDING_DEFAULT_VERSION=v2
# Omitted or empty selects the device automatically; explicit values: cpu or cuda.
# PYTHON_EMBEDDING_DEVICE=
# Standalone Python preloads v2/v3 by default. Empty explicitly skips preloading;
# the text encoder still loads at startup. Compose defaults to empty preloading.
# PYTHON_EMBEDDING_PRELOAD_MODELS=v2,v3

# --- Safety: inference runtime ---
# Keep debug mode disabled in production. Initial text-encoder startup may
# download model weights into the local cache.

# --- Environment-specific: standalone embedding and training ---
# Tuning: standalone Python process and model directory.
# PYTHON_EMBEDDING_HOST=0.0.0.0
# PYTHON_EMBEDDING_PORT=5001
# PYTHON_EMBEDDING_DEBUG=false
# PYTHON_EMBEDDING_MODEL_DIR=saved_models

# --- Optional: training database ---
# These values are read by train/dataset.py, not by the inference service.
# Replace the password example before enabling authenticated database access.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tasteinsight
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# --- Tuning: training defaults ---
# train/train.sh passes these values to train_fusion.py as command-line options.
# Direct Python invocations use the corresponding CLI options instead.
# EPOCHS=50
# BATCH_SIZE=256
# LR=0.001
# Triplet-loss margin and negative samples per positive sample.
# MARGIN=0.5
# NUM_NEGATIVES=2
# Minimum interactions per dish and the trained-model output path.
# MIN_INTERACTIONS=5
# OUTPUT=saved_models/fusion_v3.pt
