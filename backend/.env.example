# =============================================================================
# TasteInsight Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and replace every change-me value.
# Local backend and local PostgreSQL/Redis configuration. Docker deployment
# uses .env.production.example instead.
#
# Usage:
#   Local development: cp .env.example .env
#   Local infrastructure: docker compose -f docker-compose.local.yml up -d
# =============================================================================

# --- Application runtime ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Initial Superadmin ---
# Only used when no admins exist in the database
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- Database Configuration ---
POSTGRES_EXPOSE_PORT=5434
POSTGRES_USER=tasteinsight
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight_dev
# Keep this URL aligned with the PostgreSQL values above. Percent-encode any
# reserved characters in the URL password. Prisma also reads this value.
DATABASE_URL=postgresql://tasteinsight:change-me-postgres-password@localhost:5434/tasteinsight_dev?schema=public

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_EXPIRATION_TIME=3600s
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRATION_TIME=7d

# --- WeChat Mini Program ---
WECHAT_APPID=
WECHAT_SECRET=

# --- Upload Configuration ---
UPLOAD_STORAGE_TYPE=local
UPLOAD_LOCAL_PATH=./uploads-dev
# Optional. When omitted, the backend derives APP_URL + /images.
# UPLOAD_BASE_URL=http://localhost:3001/images
UPLOAD_MAX_FILE_SIZE=10485760

# --- Redis Configuration (for BullMQ async task queue and cache) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_EXPOSE_PORT=6380
REDIS_PASSWORD=change-me-redis-password
# Dedicated Redis logical database for recommendation caches.
REDIS_REC_DB=1

# --- OSS (Optional, only if UPLOAD_STORAGE_TYPE=oss) ---
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CUSTOM_DOMAIN=

# --- Embedding Services Configuration ---
# Python Embedding Service
PYTHON_EMBEDDING_HOST=0.0.0.0
PYTHON_EMBEDDING_PORT=5001
PYTHON_EMBEDDING_DEBUG=false
PYTHON_EMBEDDING_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
HF_ENDPOINT=https://huggingface.co
PYTHON_EMBEDDING_DEFAULT_VERSION=v2
PYTHON_EMBEDDING_MODEL_DIR=saved_models
PYTHON_EMBEDDING_DEVICE=
PYTHON_EMBEDDING_PRELOAD_MODELS=v2,v3

# TS Embedding Service
# Set to true to use the external Python service.
EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
EXTERNAL_EMBEDDING_SERVICE_URL=http://localhost:5001
EMBEDDING_SERVICE_BATCH_SIZE=50
EXTERNAL_EMBEDDING_SERVICE_VERSION=v2

# --- AI Chat Configuration ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Local testing ---
ENABLE_MOCK_AUTH=false
RUN_SEED=false
IMPORT_DATA=false
