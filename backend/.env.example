# =============================================================================
# TasteInsight Environment Configuration - Backend Development
# =============================================================================
# Scope: local backend, PostgreSQL and Redis.
# Load: copy to .env; start:dev and docker-compose.local.yml read that file.
# Values: active settings select the local environment; commented values are
#         optional capabilities or defaults.
# Layout: shared backend settings first, environment-specific settings last.
# Safety: replace every change-me value and keep .env outside version control.
# =============================================================================

# --- Required: application environment ---
NODE_ENV=development
APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:5173

# --- Required: PostgreSQL connection ---
POSTGRES_USER=tasteinsight
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight_dev

# --- Required: Redis connection ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change-me-redis-password

# --- Required: API signing secrets ---
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret

# --- Initialization: first administrator ---
# For a new database, uncomment and fill both to create the first administrator.
# Existing installations with administrator accounts can omit both.
# Remove them after the first successful login and password rotation.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- Optional: login method policy ---
# Allowed values: phone,wechatMiniapp,wechatApp,campusOAuth. Empty disables all login methods.
# Defaults to WeChat only; enabling a method also requires its provider credentials.
# AUTH_LOGIN_METHODS=wechatMiniapp,wechatApp

# --- Optional: campus verification method policy ---
# Allowed values: campusEmail,campusOAuth. Empty disables campus verification, including automatic verification during login.
# Defaults to both methods; each requires its provider credentials.
# CAMPUS_VERIFICATION_METHODS=campusEmail,campusOAuth

# --- Optional: WeChat Mini Program ---
# WECHAT_APPID=
# WECHAT_SECRET=

# --- Optional: WeChat mobile application ---
# WECHAT_APP_APPID=
# WECHAT_APP_SECRET=
# Stable namespace of the shared WeChat Open Platform account; required for
# cross-app UnionID linking between the Mini Program and Android/iOS apps.
# WECHAT_OPEN_PLATFORM_ID=

# --- Optional: verification delivery ---
# Independent random secret of at least 32 bytes for enabled verification channels.
# AUTH_CHALLENGE_SECRET=
# HTTPS POST body: {to, code, expiresIn, purpose}; Bearer authorization.
# Success response: {messageId: "provider-delivery-id"}.
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=
# Resend HTTPS API; EMAIL_FROM must use a verified sender domain.
# RESEND_API_KEY=
# EMAIL_FROM=
# Exact comma-separated campus domains. Email possession creates a pending application.
# CAMPUS_EMAIL_DOMAINS=

# --- Optional: campus OAuth ---
# Obtain endpoints and credentials from the approved Tsinghua integration operator.
# CAMPUS_OAUTH_AUTHORIZATION_URL=
# CAMPUS_OAUTH_TOKEN_URL=
# CAMPUS_OAUTH_USERINFO_URL=
# CAMPUS_OAUTH_CLIENT_ID=
# CAMPUS_OAUTH_CLIENT_SECRET=
# Fixed HTTPS backend /api/v1/user/student-verification/oauth/callback URL.
# CAMPUS_OAUTH_REDIRECT_URI=
# CAMPUS_OAUTH_SCOPE=
# CAMPUS_OAUTH_ISSUER=
# Only an authoritative current-student claim can grant student eligibility.
# Missing or non-matching claims produce PENDING for administrator review.
# CAMPUS_OAUTH_STUDENT_CLAIM=
# CAMPUS_OAUTH_STUDENT_VALUES=

# --- Optional: signed notification webhook ---
# An omitted or empty URL keeps delivery in the application inbox only.
# HTTPS is required; development/test also allow loopback HTTP.
# NOTIFICATION_WEBHOOK_URL=
# Independent random signing secret, at least 32 characters when URL is set.
# NOTIFICATION_WEBHOOK_SECRET=

# --- Optional: upload storage ---
# When omitted, the backend derives APP_URL + /images.
# UPLOAD_BASE_URL=http://localhost:3001/images
# Set UPLOAD_STORAGE_TYPE=oss and provide all required OSS credentials.
# OSS_REGION=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_CUSTOM_DOMAIN=

# --- Optional: external Python embedding service ---
# Set to true and run pnpm run start:embedding to use Python v2/v3 embeddings.
# EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
# EXTERNAL_EMBEDDING_SERVICE_URL=http://localhost:5001

# --- Optional: AI chat ---
# An omitted model allows the administrator's database configuration to take effect.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# --- Tuning: API, upload and identity defaults ---
# JWT_EXPIRATION_TIME=3600s
# JWT_REFRESH_EXPIRATION_TIME=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Exact reverse-proxy IPs/CIDRs only. Omitted ignores forwarded client IP headers.
# TRUSTED_PROXY_CIDRS=
# UPLOAD_STORAGE_TYPE=local
# UPLOAD_MAX_FILE_SIZE=10485760
# CAMPUS_OAUTH_SUBJECT_CLAIM=sub
# CAMPUS_OAUTH_TOKEN_AUTH_METHOD=client_secret_basic
# CAMPUS_VERIFICATION_DAYS=30

# --- Tuning: recommendation and notification defaults ---
# Dedicated Redis logical database for recommendation caches.
# REDIS_REC_DB=1
# EMBEDDING_SERVICE_BATCH_SIZE=50
# EXTERNAL_EMBEDDING_SERVICE_VERSION=v2
# NOTIFICATION_WEBHOOK_POLL_MS=5000
# NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
# NOTIFICATION_WEBHOOK_MAX_ATTEMPTS=5
# NOTIFICATION_WEBHOOK_BACKOFF_MS=5000

# --- Tuning: Python embedding defaults ---
# These defaults apply to the standalone service started by start:embedding.
# PYTHON_EMBEDDING_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# HF_ENDPOINT=https://huggingface.co
# PYTHON_EMBEDDING_DEFAULT_VERSION=v2
# PYTHON_EMBEDDING_DEVICE=
# PYTHON_EMBEDDING_PRELOAD_MODELS=v2,v3

# --- Safety: test login and maintenance ---
# Disabled by default. Enable test login only in development or isolated tests.
# RUN_SEED=false
# IMPORT_DATA=false
# ENABLE_MOCK_AUTH=false

# --- Environment-specific: local development ---
# Required: backend process and local uploads.
PORT=3001
# Keep local uploads separate from production and test data.
UPLOAD_LOCAL_PATH=./uploads-dev

# Required: local PostgreSQL and Redis host connections.
POSTGRES_EXPOSE_PORT=5434
# Keep this URL aligned with the PostgreSQL values above. Percent-encode any
# reserved characters in the URL password. Prisma also reads this value.
DATABASE_URL=postgresql://tasteinsight:change-me-postgres-password@localhost:5434/tasteinsight_dev?schema=public
# Keep this host port aligned with REDIS_PORT above.
REDIS_EXPOSE_PORT=6380

# Tuning: standalone Python process and model directory.
# PYTHON_EMBEDDING_HOST=0.0.0.0
# PYTHON_EMBEDDING_PORT=5001
# PYTHON_EMBEDDING_DEBUG=false
# PYTHON_EMBEDDING_MODEL_DIR=saved_models
