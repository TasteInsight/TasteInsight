# Host development: copy to .env, replace credentials, then start local infrastructure.
# Optional integrations and tuning: ../docs/环境变量参考.md

NODE_ENV=development
APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:5173
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=tasteinsight
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight_dev
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=3001
UPLOAD_LOCAL_PATH=./uploads-dev

# First administrator for a new database; remove after initialization.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password

# 统一内容审核（可选；在管理端启用，策略保存于数据库）
# 人工和机器审核均需配置图片签名密钥与公共 API 根地址。
# 使用 openssl rand -hex 32 生成独立随机密钥，至少 32 个字符。
# MODERATION_MEDIA_SECRET=
# MODERATION_PUBLIC_BASE_URL=http://localhost:3001
# 阿里云内容安全增强版；需开通服务并授予调用权限。
# MODERATION_ALIYUN_ACCESS_KEY_ID=
# MODERATION_ALIYUN_ACCESS_KEY_SECRET=
# MODERATION_ALIYUN_REGION=cn-shanghai
# MODERATION_ALIYUN_TEXT_SERVICE=comment_detection
# MODERATION_ALIYUN_IMAGE_SERVICE=baselineCheck
# 微信小程序内容安全；AppID 与 Secret 同时供小程序登录使用。
# WECHAT_APPID=
# WECHAT_SECRET=
# 消息推送配置中的 Token 与 43 位 EncodingAESKey，启用安全模式。
# MODERATION_WECHAT_TOKEN=
# MODERATION_WECHAT_AES_KEY=

# WeRSS 公众号采集服务（可选，API 与 Worker 使用相同连接配置）
# 配置完整时管理端显示“公众号来源”；省略时仅显示手动新闻。
# WERSS_BASE_URL=http://127.0.0.1:8001
# 开发面板经 Vite 的 /werss/ 代理访问，端口与管理端一致。
# WERSS_ADMIN_URL=http://localhost:5173/werss/
# WERSS_ACCESS_KEY=
# WERSS_SECRET_KEY=

# 同机 Compose 可选采集服务；外部 WeRSS 仅需上面的连接配置。
# COMPOSE_PROFILES=werss
# WERSS_USERNAME=admin
# 已有用户沿用数据卷中的密码；此项用于初始化新用户。
# WERSS_PASSWORD=<独立的 WeRSS 登录密码>
# WERSS_SESSION_SECRET=<随机会话签名密钥，可用 openssl rand -hex 32 生成>
# WERSS_PORT=8001
# WERSS_GATHER_MODEL=weread_mp
# 与 embedding 同时启用时使用 COMPOSE_PROFILES=embedding,werss

# 上传存储（可选，默认 local）；完整参数和权限见 ../docs/环境变量参考.md#上传存储。
# 腾讯云 COS 使用 S3 兼容接口，API 与 worker 配置一致。
# UPLOAD_DEFAULT_STORAGE_ID=s3
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
# S3_BUCKET=photos-1250000000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://images.example.com

# 多桶实例：将 UPLOAD_DEFAULT_STORAGE_ID 设为 cos-cn，文件保留各自的实例 ID。
# UPLOAD_STORAGE_INSTANCES={"cos-cn":{"type":"s3","endpoint":"https://cos.ap-guangzhou.myqcloud.com","region":"ap-guangzhou","bucket":"photos-1250000000","accessKeyId":"<SecretId>","secretAccessKey":"<SecretKey>"}}

# 用户对话 AI（OpenAI 兼容接口，可选）
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# 内容英文翻译辅助：全局管理员可在管理端独立配置，默认关闭。
# 对应环境变量优先于数据库；已设置的字段在管理端只读。
# 启用时需同时配置独立的 API Key 与模型；省略 BASE_URL 使用 OpenAI 默认地址。
# AI_TRANSLATION_ENABLED=false
# AI_TRANSLATION_API_KEY=
# AI_TRANSLATION_MODEL=
# AI_TRANSLATION_BASE_URL=https://api.openai.com/v1

# 独立推荐索引库（可选）；使用内置数据库时启用 recommendation profile。
# 将 recommendation 加入上方 COMPOSE_PROFILES；与 WeRSS 同时启用时填写 werss,recommendation。
# RECOMMENDATION_POSTGRES_USER=recommendation
# RECOMMENDATION_POSTGRES_PASSWORD=<独立推荐库口令>
# RECOMMENDATION_POSTGRES_DB=tasteinsight_recommendation
# RECOMMENDATION_DATABASE_URL=postgresql://recommendation:<URL编码后的独立推荐库口令>@localhost:5435/tasteinsight_recommendation
# HTTP 模型部署由服务端维护，管理台通过 deploymentId 选择。
# RECOMMENDATION_MODEL_DEPLOYMENTS={"embedding-production":{"url":"http://embedding-service:5001","timeoutMs":3000}}
