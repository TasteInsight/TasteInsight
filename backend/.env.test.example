# =============================================================================
# TasteInsight Environment Configuration - Backend E2E Tests
# =============================================================================
# Scope: isolated backend E2E fixtures and mocked integrations.
# Load: copy to .env.test; backend test commands read that file.
# Values: active assignments define the test fixture, including explicit tuning.
# Layout: shared backend settings first, environment-specific settings last.
# Safety: use a separate database whose name ends in _test. test:setup migrates
#         and reseeds that database; never target development or production data.
# =============================================================================

# --- Required: application environment ---
NODE_ENV=test
APP_URL=http://localhost:3000

# --- Required: Redis connection ---
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=change-me-test-redis-password

# --- Required: API signing secrets ---
# Fixed fixture values are valid only in the isolated test environment.
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-refresh-secret

# --- Initialization: first administrator ---
# Fixed fixture credentials used by test setup.
INITIAL_ADMIN_USERNAME=testadmin
INITIAL_ADMIN_PASSWORD=password123

# --- Optional: WeChat Mini Program ---
# Fixture credentials for mocked identity tests.
WECHAT_APPID=test_wechat_appid
WECHAT_SECRET=test_wechat_appsecret

# --- Optional: external Python embedding service ---
# Disabled in the standard test fixture; the endpoint uses an isolated port.
EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
EXTERNAL_EMBEDDING_SERVICE_URL=http://localhost:5002

# --- Optional: AI chat ---
# Fixture values; test mocks control AI behavior.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Tuning: API and upload defaults ---
JWT_EXPIRATION_TIME=3600s
JWT_REFRESH_EXPIRATION_TIME=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
UPLOAD_STORAGE_TYPE=local
UPLOAD_MAX_FILE_SIZE=10485760

# --- Tuning: recommendation defaults ---
REDIS_REC_DB=1

# --- Safety: test login and maintenance ---
# Test-only mocks must not be enabled in production.
RUN_SEED=false
IMPORT_DATA=false
ENABLE_MOCK_AUTH=true

# --- Environment-specific: isolated E2E tests ---
# Required: test backend process and upload directory.
PORT=3000
# Keep test uploads separate from development and production data.
UPLOAD_LOCAL_PATH=./uploads-test
# test:setup does not create PostgreSQL; this database must already exist.
DATABASE_URL=postgresql://tester:tester@localhost:5432/tasteinsight_test?schema=public

# Safety: test-only AI fixture provider.
USE_MOCK_AI_PROVIDER=true
