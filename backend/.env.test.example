# Isolated backend E2E only. Copy to .env.test. Database name must end in _test.
# Setup migrates and reseeds this database. Fixture secrets belong only to tests.

NODE_ENV=test
APP_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=change-me-test-redis-password
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-refresh-secret
INITIAL_ADMIN_USERNAME=testadmin
INITIAL_ADMIN_PASSWORD=password123
WECHAT_APPID=test_wechat_appid
WECHAT_SECRET=test_wechat_appsecret
EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
EXTERNAL_EMBEDDING_SERVICE_URL=http://localhost:5002
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
JWT_EXPIRATION_TIME=3600s
JWT_REFRESH_EXPIRATION_TIME=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
UPLOAD_DEFAULT_STORAGE_ID=local
UPLOAD_MAX_FILE_SIZE=10485760
REDIS_REC_DB=1
RUN_SEED=false
IMPORT_DATA=false
ENABLE_MOCK_AUTH=true
PORT=3000
UPLOAD_LOCAL_PATH=./uploads-test
DATABASE_URL=postgresql://tester:tester@localhost:5432/tasteinsight_test?schema=public
USE_MOCK_AI_PROVIDER=true
