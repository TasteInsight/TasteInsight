# =============================================================================
# TasteInsight Docker Production Environment
# =============================================================================
# Copy to .env.production, replace every change-me value, and keep the resulting
# file outside version control. The current gateway is HTTP-only because no
# valid TLS certificate is configured.

# --- Public application ---
HTTP_PORT=80
APP_URL=http://your-domain-or-server-ip

# --- Initial superadmin ---
# Used only when the admins table is empty. Remove these values after the first
# successful login and password rotation.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- PostgreSQL container ---
POSTGRES_USER=tasteinsight
# The backend entrypoint URL-encodes this raw password for Prisma.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight

# --- Redis container ---
REDIS_PASSWORD=change-me-redis-password
# Dedicated Redis logical database for recommendation caches.
REDIS_REC_DB=1

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_EXPIRATION_TIME=3600s
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRATION_TIME=7d

# --- WeChat Mini Program ---
WECHAT_APPID=
WECHAT_SECRET=

# --- Upload storage ---
UPLOAD_STORAGE_TYPE=local
# Optional. Defaults to APP_URL + /images.
# UPLOAD_BASE_URL=http://your-domain-or-server-ip/images
UPLOAD_MAX_FILE_SIZE=10485760

# --- OSS (only when UPLOAD_STORAGE_TYPE=oss) ---
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CUSTOM_DOMAIN=

# --- Embedding service ---
# Set to embedding together with EXTERNAL_EMBEDDING_SERVICE_ENABLED=true to run
# the Python container during local Docker and automated deployments.
COMPOSE_PROFILES=
PYTHON_EMBEDDING_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
HF_ENDPOINT=https://huggingface.co
PYTHON_EMBEDDING_DEFAULT_VERSION=v2
PYTHON_EMBEDDING_DEVICE=
# Empty skips v2/v3 preloading; the text encoder still loads at service startup.
PYTHON_EMBEDDING_PRELOAD_MODELS=
EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
EMBEDDING_SERVICE_BATCH_SIZE=50
EXTERNAL_EMBEDDING_SERVICE_VERSION=v2

# --- AI chat ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Cold-start switches ---
# seed_docker.ts deletes existing business data. Never enable for normal startup.
RUN_SEED=false
# Optional one-off Excel import. Keep false for normal startup.
IMPORT_DATA=false
ENABLE_MOCK_AUTH=false
