# =============================================================================
# TasteInsight Environment Configuration - Backend Production
# =============================================================================
# Scope: Docker production deployment with role-scoped configuration.
# Load: copy to .env.production and pass --env-file .env.production to Compose.
# Values: active settings select the deployment; commented values are optional
#         capabilities or defaults, injected only into their consuming roles.
# Layout: shared backend settings first, environment-specific settings last.
# Safety: replace change-me values and keep the file outside version control.
#         Preserve the project name and credentials on existing installations.
# =============================================================================

# --- Required: application environment ---
# NODE_ENV is fixed to production by Compose; this file cannot override it.
# NODE_ENV=production
APP_URL=https://api.example.com
ADMIN_APP_URL=https://admin.example.com

# --- Required: PostgreSQL connection ---
POSTGRES_USER=tasteinsight
# The backend entrypoint URL-encodes this raw password for Prisma.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight

# --- Required: Redis connection ---
# REDIS_HOST=redis
# REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- Required: API signing secrets ---
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret

# --- Initialization: first administrator ---
# These credentials are consumed only by migrate.
# For a new database, uncomment and fill both to create the first administrator.
# Existing installations with administrator accounts can omit both.
# Without them, migration succeeds but no administrator is created.
# Remove them after the first successful login and password rotation.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- Required: WeChat Mini Program ---
# Consumed only by public-api.
WECHAT_APPID=change-me-wechat-appid
WECHAT_SECRET=change-me-wechat-secret

# --- Optional: upload storage ---
# Consumed by public-api and admin-api.
# Defaults to APP_URL + /images. Container upload path is fixed at /app/uploads.
# UPLOAD_BASE_URL=https://api.example.com/images
# Set UPLOAD_STORAGE_TYPE=oss and provide all required OSS credentials.
# OSS_REGION=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_CUSTOM_DOMAIN=

# --- Optional: external Python embedding service ---
# Enable COMPOSE_PROFILES=embedding in the environment-specific section to run
# the Python container together with EXTERNAL_EMBEDDING_SERVICE_ENABLED=true.
# EXTERNAL_EMBEDDING_SERVICE_ENABLED=false
# EXTERNAL_EMBEDDING_SERVICE_URL=http://embedding-service:5001

# --- Optional: AI chat ---
# Consumed only by public-api.
# An omitted model allows the administrator's database configuration to take effect.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# --- Tuning: API and upload defaults ---
# JWT_EXPIRATION_TIME=3600s
# JWT_REFRESH_EXPIRATION_TIME=7d
# Additional browser origins only; APP_URL and ADMIN_APP_URL are allowed automatically.
# CORS_ALLOWED_ORIGINS=
# Exact private reverse-proxy IPs/CIDRs. Omitted ignores forwarded client IP headers.
# TRUSTED_PROXY_CIDRS=
# UPLOAD_STORAGE_TYPE=local
# UPLOAD_MAX_FILE_SIZE=10485760

# --- Tuning: recommendation defaults ---
# Dedicated Redis logical database for recommendation caches.
# REDIS_REC_DB=1
# EMBEDDING_SERVICE_BATCH_SIZE=50
# EXTERNAL_EMBEDDING_SERVICE_VERSION=v2

# --- Tuning: Python embedding defaults ---
# These defaults apply only when the embedding Compose profile is enabled.
# PYTHON_EMBEDDING_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# HF_ENDPOINT=https://huggingface.co
# PYTHON_EMBEDDING_DEFAULT_VERSION=v2
# PYTHON_EMBEDDING_DEVICE=
# Omitted or empty skips v2/v3 preloading in Compose; the text encoder still loads
# at startup. Standalone Python defaults to v2,v3.
# PYTHON_EMBEDDING_PRELOAD_MODELS=

# --- Safety: production runtime ---
# All three flags are disabled by default; enabling any flag is rejected.
# RUN_SEED=false
# Import is an explicit maintenance command, never a production startup action.
# IMPORT_DATA=false
# ENABLE_MOCK_AUTH=false

# --- Environment-specific: Docker production ---
# Required: gateway ports and persistent project identity.
HTTP_PORT=80
HTTPS_PORT=443
# Keep the existing project name on upgrades so named volumes retain identity.
COMPOSE_PROJECT_NAME=tasteinsight-production
# on: this gateway terminates TLS; off: HTTP or a trusted external TLS proxy.
GATEWAY_TLS_MODE=on
# Host directory containing a full chain and private key for BOTH domains.
# Existing acme.sh --install-cert output directories can be mounted unchanged.
TLS_CERTS_PATH=./certs

# Tuning: gateway and container connection defaults.
# TLS_CERT_FILE=fullchain.pem
# TLS_KEY_FILE=private.key
# Nginx >= 1.27.3 is required for Docker DNS-aware upstreams.
# NGINX_IMAGE=nginx:1.28-alpine
# WORKER_STOP_GRACE_PERIOD=90s
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional: local Docker and automated deployment of the Python container.
# Requires EXTERNAL_EMBEDDING_SERVICE_ENABLED=true in the shared section.
# COMPOSE_PROFILES=embedding
