# Complete container deployment on one machine; usable locally or on a server.
# Copy to a private env file and select it with docker compose --env-file <file>.
# Optional integrations and tuning: ../docs/环境变量参考.md
# Preserve COMPOSE_PROJECT_NAME and database credentials on existing deployments.

APP_URL=https://api.example.com
ADMIN_APP_URL=https://admin.example.com
POSTGRES_USER=tasteinsight
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasteinsight
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-to-a-long-random-access-token-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret
HTTP_PORT=80
HTTPS_PORT=443
COMPOSE_PROJECT_NAME=tasteinsight-production
GATEWAY_TLS_MODE=on
TLS_CERTS_PATH=./certs

# First administrator for a new database; remove after initialization.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-initial-admin-password
