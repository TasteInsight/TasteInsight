# Development defaults work without an env file.
# Copy to .env.development.local for a development backend override,
# or .env.production.local for release-specific values. Custom Vite modes remain supported.
# VITE_* values are embedded in public assets; keep secrets in the backend.
# VITE_API_BASE_URL=https://api.example.invalid/api/v1
# The management release defaults to same-origin /api/v1.
