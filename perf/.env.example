# Local harness: node perf/local.mjs --env-file perf/.env
PROFILE=smoke
RATE=2
MAX_VUS=20
DURATION=5m
P95_MS=1500
# smoke defaults to zero tolerated errors; other profiles default to 0.01.
# ERROR_RATE=0
DISHES_PER_SLOT=20
# k6 executable on PATH, or an absolute executable path.
# K6_BIN=/path/to/k6
# Optional measured business mix. Omitted workflows are disabled for load/stress/soak.
# Smoke always covers all workflows.
# JOURNEY_WEIGHTS={"browsing":80,"social":10,"posting":5,"planning":5}

# Existing isolated deployment: node perf/run.mjs --env-file perf/.env
# Complete API prefixes are supported. Use a dedicated empty test database.
# PUBLIC_BASE_URL=https://api.example.invalid/api/v1
# ADMIN_BASE_URL=https://admin.example.invalid/api/v1
# FIXTURES_FILE=results/fixtures.json
# RESULTS_DIR=/private/path/to/results

# Provisioning only; signing keys must match the isolated test backend.
# The workload subprocess receives tokens, not these database/signing secrets.
# FIXTURE_DATABASE_URL=postgresql://perf:replace-me@localhost:5432/tasteinsight_perf_0123456789abcdef
# FIXTURE_JWT_SECRET=
# FIXTURE_JWT_REFRESH_SECRET=

# Release browser suite: node perf/frontend-local.mjs --env-file perf/.env
# Hybrid mode requires PROFILE=load. Provision MAX_VUS+1 slots for remote runs.
# FRONTEND_MODE=hybrid
# FRONTEND_SAMPLES=3
# FRONTEND_FCP_MS=3000
# FRONTEND_LCP_MS=4500
# FRONTEND_CLS=0.1
# FRONTEND_READY_MS=10000
# FRONTEND_ACTION_MS=8000
