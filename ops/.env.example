# Copy to .env on the server; restrict permissions to the operator.
OPS_PROJECT_NAME=tasteinsight-ops
# Match the deployed application's actual network and volume names.
APP_NETWORK=tasteinsight-production_tasteinsight_net
APP_DATABASE_NETWORK=tasteinsight-production_db_net
APP_UPLOADS_VOLUME=tasteinsight-production_uploads_data

# Probe real read-only public routes; HTTPS is recommended in production.
PROBE_CATALOG_URL=https://api.example.invalid/api/v1/canteens
PROBE_COMMUNITY_URL=https://api.example.invalid/api/v1/posts
PROBE_ADMIN_URL=https://admin.example.invalid/login
PUBLIC_HEALTH_URL=http://public-api:3000/health
ADMIN_HEALTH_URL=http://admin-api:3000/health
WORKER_HEALTH_URL=http://worker:3000/health
STATUS_PORT=8088
STATUS_NOTICE=
GRAFANA_PORT=3300
GRAFANA_ROOT_URL=https://monitor.example.invalid
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECURE_COOKIE=true
# Enable the host Compose profile on a Linux server when true.
MONITOR_HOST=false

BACKUP_DB_HOST=db
BACKUP_DB_PORT=5432
# Shared by backup and PostgreSQL metrics; require enables mandatory TLS.
BACKUP_DB_SSLMODE=disable
BACKUP_DB_NAME=tasteinsight
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
# A dedicated read-only account with pg_monitor granted.
METRICS_DB_USER=
METRICS_DB_PASSWORD=
METRICS_REDIS_HOST=redis
METRICS_REDIS_PORT=6379
METRICS_REDIS_PASSWORD=

# Example S3-compatible repository; use an independent bucket/prefix.
RESTIC_REPOSITORY=s3:https://s3.example.com/tasteinsight-backups
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_HOST=tasteinsight-production
BACKUP_RELEASE=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_MAX_AGE_SECONDS=90000
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_COMMAND_TIMEOUT_SECONDS=14400

# none | webhook | email. Generic webhook expects Alertmanager JSON.
ALERT_CHANNEL=none
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Restore always uses its own database and volumes; choose a new project per drill.
RESTORE_PROJECT_NAME=tasteinsight-restore
RESTORE_DB_PASSWORD=
RESTORE_SNAPSHOT=
