worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;
    upstream kuma {
        zone kuma 64k;
        server uptime-kuma:3001 resolve;
    }
    map $http_x_forwarded_proto $public_proto {
        default $scheme;
        https https;
    }
    map $uri $public_cache {
        default "no-store";
        ~^/assets/ "public, max-age=86400, immutable";
    }
    server {
        listen 8080;
        absolute_redirect off;
        # Setup and every route stay closed until an operator enables publication.
        set $public_enabled "${STATUS_PUBLIC_ENABLED}";
        if ($public_enabled = "false") { return 503; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control $public_cache always;
        # Kuma's server-rendered preload and custom styles require inline content.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" always;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $public_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Frame-Options;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_intercept_errors on;
        error_page 404 = @missing;
        error_page 502 503 504 = @unavailable;

        location = / { return 302 /status/${STATUS_PAGE_SLUG}; }
        location = /status/${STATUS_PAGE_SLUG} { proxy_pass http://kuma; }
        location = /status/${STATUS_PAGE_SLUG}/rss { proxy_pass http://kuma; }
        location = /api/status-page/${STATUS_PAGE_SLUG} { proxy_pass http://kuma; }
        location = /api/status-page/heartbeat/${STATUS_PAGE_SLUG} { proxy_pass http://kuma; }
        location = /api/status-page/${STATUS_PAGE_SLUG}/manifest.json { proxy_pass http://kuma; }
        location = /api/status-page/${STATUS_PAGE_SLUG}/incident-history { proxy_pass http://kuma; }

        # Only built frontend resources and PNG status-page logos are public.
        location ~ ^/assets/[a-zA-Z0-9_.-]+\.(js|css|woff2?|ttf|svg|png)$ { proxy_pass http://kuma; }
        location ~ ^/upload/logo[0-9]+\.png$ { proxy_pass http://kuma; }
        location = /serviceWorker.js { proxy_pass http://kuma; }
        location = /icon-192x192.png { proxy_pass http://kuma; }
        location = /icon-512x512.png { proxy_pass http://kuma; }
        location = /icon.svg { proxy_pass http://kuma; }
        location = /icon.png { proxy_pass http://kuma; }
        location = /apple-touch-icon.png { proxy_pass http://kuma; }
        location = /favicon.ico { proxy_pass http://kuma; }
        # Includes /socket.io/, dashboard, setup, metrics, push and monitor badges.
        location / { return 404; }
        location @missing { default_type text/plain; return 404 "Not found\n"; }
        location @unavailable { default_type text/plain; return 503 "Status temporarily unavailable\n"; }
    }
}
