{
  "easycom": {
    "autoscan": true,
    "custom": {
      // uni-ui 规则如下配置
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "食鉴",
        "navigationBarBackgroundColor": "#FFFFFF",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/search/index",
      "style": {
        "navigationBarTitleText": "搜索"
      }
    },
    {
      "path": "pages/canteen/index",
      "style": {
        "navigationBarTitleText": "食堂",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/window/index",
      "style": {
        "navigationBarTitleText": "窗口详情"
      }
    },
    {
      "path": "pages/dish/index",
      "style": {
        "navigationBarTitleText": "菜品详情",
        "disableScroll": false,
        "enablePullDownRefresh": true,
        "navigationStyle": "default"
      }
    },
    {
      "path": "pages/dish/components/TagList",
      "style": {
        "navigationBarTitleText": "标签菜品",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/news/index",
      "style": {
        "navigationBarTitleText": "新闻",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/news/components/detail",
      "style": {
        "navigationBarTitleText": "新闻详情"
      }
    },
    {
      "path": "pages/planning/index",
      "style": {
        "navigationBarTitleText": "规划",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/ai-chat/index",
      "style": {
        // #ifdef APP-PLUS
        "app-plus": {
          "softinputMode": "adjustResize"
        },
        // #endif
        "navigationBarTitleText": "AI 助手"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/identity",
      "style": { "navigationBarTitleText": "账号与校园身份" }
    },
    // #ifdef MP-WEIXIN
    {
      "path": "pages/login/campus-auth",
      "style": { "navigationBarTitleText": "校园账号登录" }
    },
    {
      "path": "pages/profile/campus-auth",
      "style": { "navigationBarTitleText": "校园统一认证" }
    },
    // #endif
    // #ifndef MP-WEIXIN
    {
      "path": "pages/community/index",
      "style": { "navigationBarTitleText": "校园", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/community/detail",
      "style": { "navigationBarTitleText": "帖子" }
    },
    {
      "path": "pages/community/editor",
      "style": { "navigationBarTitleText": "写帖子" }
    },
    {
      "path": "pages/profile/public",
      "style": { "navigationBarTitleText": "个人主页" }
    },
    {
      "path": "pages/planning/dining",
      "style": { "navigationBarTitleText": "约饭", "enablePullDownRefresh": true }
    },
    // #endif
    {
      "path": "pages/notifications/index",
      "style": { "navigationBarTitleText": "消息", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/notifications/weekly",
      "style": { "navigationBarTitleText": "本周推荐" }
    },

    {
      "path": "pages/easter-egg/index",
      "style": {
        "navigationBarTitleText": "食鉴彩蛋"
      }
    },
    {
      "path": "pages/add-dish/index",
      "style": {
        "navigationBarTitleText": "申请新增菜品"
      }
    }
  ],

  "subPackages": [
    {
      "root": "pages/settings",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "设置"
          }
        },
        {
          "path": "components/personal",
          "style": {
            "navigationBarTitleText": "个人信息"
          }
        },
        {
          "path": "components/avatar-crop",
          "style": {
            "navigationBarTitleText": "裁剪头像"
          }
        },
        {
          "path": "components/allergens",
          "style": {
            "navigationBarTitleText": "过敏原设置"
          }
        },
        {
          "path": "components/preferences",
          "style": {
            "navigationBarTitleText": "偏好设置"
          }
        },
        {
          "path": "components/display",
          "style": {
            "navigationBarTitleText": "显示设置"
          }
        },
        {
          "path": "components/notifications",
          "style": {
            "navigationBarTitleText": "通知设置"
          }
        },
        {
          "path": "privacy",
          "style": {
            "navigationBarTitleText": "隐私政策"
          }
        },
        {
          "path": "about",
          "style": {
            "navigationBarTitleText": "关于食鉴"
          }
        }
      ]
    },
    {
      "root": "pages/profile/my-uploads",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "我的上传",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/profile/my-reviews",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "我的评价",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/profile/my-reports",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "我的举报",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/profile/history",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "历史浏览",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/profile/my-favorites",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "我的收藏",
            "enablePullDownRefresh": true
          }
        }
      ]
    }
  ],

  "tabBar": {
    "color": "#667085",
    "selectedColor": "#660874",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/tabbar/index-line.png",
        "selectedIconPath": "static/tabbar/index-line-active.png",
        "text": "首页"
      },
      // #ifdef MP-WEIXIN
      {
        "pagePath": "pages/news/index",
        "iconPath": "static/tabbar/news-line.png",
        "selectedIconPath": "static/tabbar/news-line-active.png",
        "text": "新闻"
      },
      // #endif
      // #ifndef MP-WEIXIN
      {
        "pagePath": "pages/community/index",
        "iconPath": "static/tabbar/campus-line.png",
        "selectedIconPath": "static/tabbar/campus-line-active.png",
        "text": "校园"
      },
      // #endif
      {
        "pagePath": "pages/planning/index",
        "iconPath": "static/tabbar/planning-line.png",
        "selectedIconPath": "static/tabbar/planning-line-active.png",
        "text": "规划"
      },
      {
        "pagePath": "pages/ai-chat/index",
        "iconPath": "static/tabbar/ai-chat-line.png",
        "selectedIconPath": "static/tabbar/ai-chat-line-active.png",
        "text": "问AI"
      },
      {
        "pagePath": "pages/profile/index",
        "iconPath": "static/tabbar/profile-line.png",
        "selectedIconPath": "static/tabbar/profile-line-active.png",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF"
  }
}
