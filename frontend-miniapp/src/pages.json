{
  "easycom": {
    "autoscan": true,
    "custom": {
      // uni-ui 规则如下配置
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "%nav.home%",
        "navigationBarBackgroundColor": "#FFFFFF",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "%nav.login%",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/search/index",
      "style": {
        "navigationBarTitleText": "%nav.search%"
      }
    },
    {
      "path": "pages/canteen/index",
      "style": {
        "navigationBarTitleText": "%nav.canteen%",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/window/index",
      "style": {
        "navigationBarTitleText": "%nav.window%"
      }
    },
    {
      "path": "pages/dish/index",
      "style": {
        "navigationBarTitleText": "%nav.dish%",
        "disableScroll": false,
        "enablePullDownRefresh": true,
        "navigationStyle": "default"
      }
    },
    {
      "path": "pages/dish/components/TagList",
      "style": {
        "navigationBarTitleText": "%nav.tags%",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/news/index",
      "style": {
        "navigationBarTitleText": "%nav.news%",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/news/components/detail",
      "style": {
        "navigationBarTitleText": "%nav.newsDetail%"
      }
    },
    {
      "path": "pages/planning/index",
      "style": {
        "navigationBarTitleText": "%nav.planning%",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/ai-chat/index",
      "style": {
        // #ifdef APP-PLUS
        "app-plus": {
          "softinputMode": "adjustResize"
        },
        // #endif
        "navigationBarTitleText": "%nav.ai%"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "%nav.profile%",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/identity",
      "style": { "navigationBarTitleText": "%nav.identity%" }
    },
    // #ifdef MP-WEIXIN
    {
      "path": "pages/login/campus-auth",
      "style": { "navigationBarTitleText": "%nav.campusLogin%" }
    },
    {
      "path": "pages/profile/campus-auth",
      "style": { "navigationBarTitleText": "%nav.campusOAuth%" }
    },
    // #endif
    // #ifndef MP-WEIXIN
    {
      "path": "pages/community/index",
      "style": { "navigationBarTitleText": "%nav.community%", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/community/detail",
      "style": { "navigationBarTitleText": "%nav.post%" }
    },
    {
      "path": "pages/community/editor",
      "style": { "navigationBarTitleText": "%nav.compose%" }
    },
    {
      "path": "pages/profile/public",
      "style": { "navigationBarTitleText": "%nav.publicProfile%" }
    },
    {
      "path": "pages/planning/dining",
      "style": { "navigationBarTitleText": "%nav.dining%", "enablePullDownRefresh": true }
    },
    // #endif
    {
      "path": "pages/notifications/index",
      "style": { "navigationBarTitleText": "%nav.notifications%", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/notifications/weekly",
      "style": { "navigationBarTitleText": "%nav.weekly%" }
    },

    {
      "path": "pages/easter-egg/index",
      "style": {
        "navigationBarTitleText": "%nav.easterEgg%"
      }
    },
    {
      "path": "pages/add-dish/index",
      "style": {
        "navigationBarTitleText": "%nav.addDish%"
      }
    }
  ],

  "subPackages": [
    {
      "root": "pages/settings",
      "pages": [
        { "path": "index", "style": { "navigationBarTitleText": "%nav.settings%" } },
        { "path": "language", "style": { "navigationBarTitleText": "%nav.language%" } },
        { "path": "components/personal", "style": { "navigationBarTitleText": "%nav.personal%" } },
        { "path": "components/avatar-crop", "style": { "navigationBarTitleText": "%nav.crop%" } },
        {
          "path": "components/allergens",
          "style": { "navigationBarTitleText": "%nav.allergens%" }
        },
        {
          "path": "components/preferences",
          "style": { "navigationBarTitleText": "%nav.preferences%" }
        },
        { "path": "components/display", "style": { "navigationBarTitleText": "%nav.display%" } },
        {
          "path": "components/notifications",
          "style": { "navigationBarTitleText": "%nav.notificationSettings%" }
        },
        { "path": "privacy", "style": { "navigationBarTitleText": "%nav.privacy%" } },
        { "path": "about", "style": { "navigationBarTitleText": "%nav.about%" } }
      ]
    },
    {
      "root": "pages/profile/records",
      "pages": [
        {
          "path": "my-uploads/index",
          "style": { "navigationBarTitleText": "%nav.uploads%", "enablePullDownRefresh": true }
        },
        {
          "path": "my-reviews/index",
          "style": { "navigationBarTitleText": "%nav.reviews%", "enablePullDownRefresh": true }
        },
        {
          "path": "my-reports/index",
          "style": { "navigationBarTitleText": "%nav.reports%", "enablePullDownRefresh": true }
        },
        {
          "path": "history/index",
          "style": { "navigationBarTitleText": "%nav.history%", "enablePullDownRefresh": true }
        },
        {
          "path": "my-favorites/index",
          "style": { "navigationBarTitleText": "%nav.favorites%", "enablePullDownRefresh": true }
        }
      ]
    }
  ],

  "tabBar": {
    "color": "#667085",
    "selectedColor": "#660874",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/tabbar/index-line.png",
        "selectedIconPath": "static/tabbar/index-line-active.png",
        "text": "%nav.tabHome%"
      },
      // #ifdef MP-WEIXIN
      {
        "pagePath": "pages/news/index",
        "iconPath": "static/tabbar/news-line.png",
        "selectedIconPath": "static/tabbar/news-line-active.png",
        "text": "%nav.tabNews%"
      },
      // #endif
      // #ifndef MP-WEIXIN
      {
        "pagePath": "pages/community/index",
        "iconPath": "static/tabbar/campus-line.png",
        "selectedIconPath": "static/tabbar/campus-line-active.png",
        "text": "%nav.tabCampus%"
      },
      // #endif
      {
        "pagePath": "pages/planning/index",
        "iconPath": "static/tabbar/planning-line.png",
        "selectedIconPath": "static/tabbar/planning-line-active.png",
        "text": "%nav.tabPlans%"
      },
      {
        "pagePath": "pages/ai-chat/index",
        "iconPath": "static/tabbar/ai-chat-line.png",
        "selectedIconPath": "static/tabbar/ai-chat-line-active.png",
        "text": "%nav.tabAI%"
      },
      {
        "pagePath": "pages/profile/index",
        "iconPath": "static/tabbar/profile-line.png",
        "selectedIconPath": "static/tabbar/profile-line-active.png",
        "text": "%nav.tabProfile%"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF"
  }
}
